{
  "$schema": "https://raw.githubusercontent.com/dotnet/docfx/main/schemas/docfx.schema.json",
  "metadata": [
    {
      "src": [
        {
          "src": "../src",
          "files": [
            "**/*.csproj"
          ],
          "exclude": [
            "FeatureManagement.Optimizely.Tests/**"
          ]
        }
      ],
      "dest": "api"
    }
  ],
  "build": {
    "content": [
      {
        "files": [
          "**/*.{md,yml}"
        ],
        "exclude": [
          "_site/**"
        ]
      }
    ],
    "output": "_site",
    "template": [
      "default",
      "modern"
    ],
    "sitemap": {
      "baseUrl": "https://tarantoj.github.io/FeatureManagement.Optimizely/",
      "priority": 0.5,
      "changefreq": "weekly"
    },
    "globalMetadata": {
      "_appName": "FeatureManagement.Optimizely",
      "_appTitle": "FeatureManagement.Optimizely",
      "_enableSearch": true,
      "_enableNewTab": true,
      "pdf": false
    }
  }
}
